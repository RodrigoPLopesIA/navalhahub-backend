
{
  "info": {
    "name": "NavalhaHub - Barbershops",
    "description": "Collection para testar os endpoints de barbearias da API NavalhaHub.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "barbershopId",
      "value": "SUBSTITUA_PELO_ID"
    }
  ],
  "item": [
    {
      "name": "Barbershops",
      "item": [
        {
          "name": "Criar barbearia",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/barbershops",
            "description": "Cria uma barbearia. Substitua o corpo {} pelos campos obrigatórios de BarbershopRequest."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    if (response.id) {",
                  "        pm.collectionVariables.set('barbershopId', response.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar barbearias",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/barbershops"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Resposta é uma lista', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar barbearia por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/barbershops/{{barbershopId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Atualizar barbearia",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/barbershops/{{barbershopId}}",
            "description": "Atualiza a barbearia. Informe os campos esperados por BarbershopRequest."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Ativar barbearia",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/api/barbershops/{{barbershopId}}/status?active=true"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Desativar barbearia",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/api/barbershops/{{barbershopId}}/status?active=false"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Excluir barbearia",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/barbershops/{{barbershopId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204 No Content', function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}